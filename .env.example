# Web UI + REST API
API_PORT=15001
# Modbus TCP server (the gateway polls this; port 502 needs root, so 5020 by default)
MODBUS_PORT=5020
# Where templates.json / devices.json are stored
DATA_DIR=./data
# IP shown in the "Add to gateway" helper (set this when running in Docker - the container can't see the PC's IP)
# PUBLIC_HOST=10.129.2.26
LOGLEVEL=INFO
